<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android API < 31 (Auto Backup).
   Excludes all authentication/session SharedPreferences and the Room database
   from cloud backup so that login state is never restored after
   uninstall/reinstall.

   Non-sensitive data that does not exist yet can still be backed up by
   adding explicit <include> rules here in the future.

   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices running API 31+.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude authentication SharedPreferences -->
    <exclude domain="sharedpref" path="LoginPrefs.xml"/>
    <exclude domain="sharedpref" path="APP_STATE.xml"/>
    <exclude domain="sharedpref" path="AttendancePrefs.xml"/>
    <exclude domain="sharedpref" path="SyncPrefs.xml"/>
    <exclude domain="sharedpref" path="app_prefs.xml"/>

    <!-- Exclude Room database files -->
    <exclude domain="database" path="app_database"/>
    <exclude domain="database" path="app_database-shm"/>
    <exclude domain="database" path="app_database-wal"/>
    <exclude domain="database" path="app_database-journal"/>
</full-backup-content>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp">

    <!-- Top Brand Area -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoCard"
        android:layout_width="62dp"
        android:layout_height="58dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="0dp"

        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:src="@drawable/splsh_logo"
            android:scaleType="fitCenter"
            android:contentDescription="App Logo" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Face Attendance"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/logoCard"
        app:layout_constraintTop_toTopOf="@id/logoCard"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAppSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="3dp"
        android:text="Secure setup for staff and faculty"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/logoCard"
        app:layout_constraintTop_toBottomOf="@id/txtAppTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Card (same id) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/formCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"

        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.40">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <!-- Card Header -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configure"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Enter server details and credentials to continue."
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Server URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Server URL"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_container"
                android:hint="https://xyz.digitaledu.in"
                android:inputType="textUri"
                android:padding="14dp"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:textCursorDrawable="@null" />

            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Username"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_container"
                android:hint="Enter username"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:textCursorDrawable="@null" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Password"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_container"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textSize="14sp"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:textCursorDrawable="@null" />

            <!-- Primary Action -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_rounded"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/blue_primary"
                android:indeterminateTintMode="src_in" />

            <!-- Footer Note -->
            <TextView
                android:id="@+id/txtFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Your data is processed securely as per institutional policy."
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

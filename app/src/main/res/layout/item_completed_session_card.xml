<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <!-- Top Header: Period & Subject -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPeriodTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Period 1"
                android:textColor="#1A237E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Mathematics"
                android:textColor="#3949AB"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvClassAndTeacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Class 10A | Teacher: John Doe"
            android:textColor="#616161"
            android:textSize="13sp" />

        <!-- Counts Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/tvPresentCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#E8F5E9"
                android:gravity="center"
                android:padding="6dp"
                android:text="28 P"
                android:textColor="#2E7D32"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLateCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#FFF8E1"
                android:gravity="center"
                android:padding="6dp"
                android:text="0 L"
                android:textColor="#F57F17"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAbsentCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#FFEBEE"
                android:gravity="center"
                android:padding="6dp"
                android:text="2 A"
                android:textColor="#C62828"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExemptedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#EDE7F6"
                android:gravity="center"
                android:padding="6dp"
                android:text="0 E"
                android:textColor="#512DA8"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tap Action Prompt -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1A237E"
            android:gravity="center"
            android:padding="8dp"
            android:text=" Edit Cycle"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

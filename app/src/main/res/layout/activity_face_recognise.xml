<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- TOP SELECTOR CARD -->
    <LinearLayout
        android:id="@+id/selectorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/white_transparent_card"
        android:padding="10dp"
        android:elevation="6dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Type"
                android:textColor="#6B6B6B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectUserType"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_container"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="Select User Type"
                android:textColor="#111111"
                android:textSize="14sp"
                android:drawableEnd="@drawable/outline_arrow_drop_down_24"
                android:drawableTint="#6B6B6B" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutClassSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Class"
                android:textColor="#6B6B6B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectClass"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_container"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="All Classes"
                android:textColor="#111111"
                android:textSize="14sp"
                android:drawableEnd="@drawable/outline_arrow_drop_down_24"
                android:drawableTint="#6B6B6B" />
        </LinearLayout>

    </LinearLayout>

    <!-- CAMERA PREVIEW AREA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cameraFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#11000000"
        app:layout_constraintTop_toBottomOf="@+id/selectorCard"
        app:layout_constraintBottom_toTopOf="@+id/infoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Top overlay header -->
            <LinearLayout
                android:id="@+id/topOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_top_fade">

                <TextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verify your identity"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScreenHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Align your face inside the circle"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Oval guide + live YuNet five-point landmark overlay -->
            <View
                android:id="@+id/faceGuide"
                android:layout_width="240dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/oval_face_guide" />

            <com.digitaledu.selfieattendance.view.FaceLandmarkOverlay
                android:id="@+id/landmarkOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Bottom overlay hint (optional) -->
            <TextView
                android:id="@+id/tvBottomHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_hint_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Good lighting improves accuracy"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- USER INFORMATION CARD -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/white_transparent_card"
        android:elevation="6dp"
        android:layout_marginTop="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMatchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face Not Detected"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Simple status pill (you can update text/color dynamically) -->
            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#1E5EFF"
                android:background="@drawable/bg_pill_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#15000000" />

        <!-- User info (labels + values style without extra ids) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="#6B6B6B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#111111"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Role"
            android:textColor="#6B6B6B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUserRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#111111"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />



        <TextView
            android:id="@+id/tvExtraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#111111"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnMassVerify"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:text="⚡ Mass Verify (Batch Test)"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvEnrollHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registration"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/text_dark"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvEnrollSubHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Automatic YuNet landmark capture with SFace"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Counters Card -->
            <LinearLayout
                android:id="@+id/cardCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_white_rounded"
                android:orientation="horizontal"
                android:padding="16dp"
                android:baselineAligned="false">

                <!-- Unregistered Section -->
                <LinearLayout
                    android:id="@+id/cardUnregisteredUsers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unregistered"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUnregisteredCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#E05B5B"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E5E7EB"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Total Section -->
                <LinearLayout
                    android:id="@+id/cardTotalUsers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Users"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- LIST DROPDOWN (same id) -->
<!--            <ListView-->
<!--                android:id="@+id/listUsers"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="180dp"-->
<!--                android:visibility="gone"-->
<!--                android:background="@drawable/list_dropdown_bg"-->
<!--                android:padding="6dp"-->
<!--                android:divider="#E5E7EB"-->
<!--                android:dividerHeight="1dp"-->
<!--                android:layout_marginBottom="14dp" />-->
            <ListView
                android:id="@+id/listUsers"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:visibility="gone"
                android:background="@drawable/list_dropdown_bg"
                android:padding="6dp"
                android:divider="#E5E7EB"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/list_item_selector"
                android:layout_marginBottom="14dp" />


            <!-- MAIN CARD (same id) -->
            <LinearLayout
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp">

                <!-- Section: User Type -->
                <TextView
                    android:id="@+id/tvUserTypeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Type"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioUserType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RadioButton
                        android:id="@+id/rbStudent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Student"
                        android:textColor="@color/text_dark"
                        android:buttonTint="@color/blue_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbStaff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Teacher"
                        android:textColor="@color/text_dark"
                        android:buttonTint="@color/blue_primary" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E5E7EB" />

                <!-- Section: Action Type -->
                <TextView
                    android:id="@+id/tvActionTypeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Action Type"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioActionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RadioButton
                        android:id="@+id/rbAdd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add New"
                        android:textColor="@color/text_dark"
                        android:buttonTint="@color/blue_primary" />

                    <RadioButton
                        android:id="@+id/rbUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Update"
                        android:textColor="@color/text_dark"
                        android:buttonTint="@color/blue_primary" />

                    <RadioButton
                        android:id="@+id/rbDelete"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Delete"
                        android:textColor="@color/text_dark"
                        android:buttonTint="@color/blue_primary" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E5E7EB" />

                <!-- Section: Search -->
                <TextView
                    android:id="@+id/tvSearchTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editSearchId"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:hint="Search by name"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:background="@drawable/bg_container"
                    android:paddingHorizontal="12dp"
                    android:inputType="text"
                    android:textCursorDrawable="@null" />

                <!-- Section: Display Name -->
                <TextView
                    android:id="@+id/tvNameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Display Name"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:hint="Display name"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:background="@drawable/bg_container"
                    android:paddingHorizontal="12dp"
                    android:enabled="false"
                    android:textCursorDrawable="@null" />

                <!-- Primary CTA -->
                <Button
                    android:id="@+id/btnEnrollFace"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/btn_rounded"
                    android:text="Start Automatic Face Scan"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvSecurityNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="The camera automatically combines 3 consistent samples after landmarks, pose, and sharpness pass."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Batch Simulation Button -->
                <Button
                    android:id="@+id/btnSimulateRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:visibility="gone"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#475569"
                    android:text="⚡ Simulate Batch Image Registration"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/white" />

            </LinearLayout>

            <!-- INSTRUCTIONS CARD (same id) -->
            <LinearLayout
                android:id="@+id/instructionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvInstructionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="During Automatic Capture"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInstructionSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Follow the live oval and landmark guidance:"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Keep both eyes, nose, and mouth corners visible"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Look straight and hold still in good light"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Hold still while 3 consistent quality samples are combined"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
